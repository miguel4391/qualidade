<%- include('partials/header') %>
<%
// Pequeno helper local para formatar a data para o input type="date" (yyyy-mm-dd).
function formatDateInput(d) {
    if (!d) return '';
    const dt = new Date(d);
    const pad = (n) => String(n).padStart(2, '0');
    return `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`;
}
%>
<style>
    .no-click {
        pointer-events: none;
        background-color: #e9ecef;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
    }

    .areas-funcionais-display {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 6px;
    }

    .area-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.85rem;
    }

    .area-badge.visivel {
        background-color: #e6f4ea;
        color: #1e7e34;
        border: 1px solid #b7dfc0;
    }

    .area-badge.nao-visivel {
        background-color: #f1f1f1;
        color: #777;
        border: 1px dashed #ccc;
    }

    .area-badge small {
        font-size: 0.75rem;
        font-style: italic;
    }
</style>
<div class="container mt-5">
  <div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <h1>Ficha de Colaborador</h1>
        <h4>Pessoal Técnico, Administrativo e de Gestão</h4>
        <form action="/enviarColab" method="POST">
            <!-- Bloco 1: Identificação Básica -->
            <div class="row mt-3">
                <div class="col-md-6 mb-3">
                    <div class="input-group">
                        <span class="input-group-text" id="numeroAddon">Nº</span>
                        <!-- CORREÇÃO: em modo edição o Nº fica readonly, porque é a
                             chave usada para encontrar/atualizar o colaborador
                             (o /enviarColab faz UPDATE por "numero"; mudá-lo aqui
                             criaria um colaborador novo em vez de atualizar o atual). -->
                        <input type="text" class="form-control no-click" id="tbNumero" name="tbNumero"
                            aria-label="tbNumero" aria-describedby="numeroAddon"
                            value="<%= colab ? colab.numero : '' %>"
                            <% if (colab) { %> readonly <% } %>
                            required>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="input-group">
                        <span class="input-group-text" id="nomeAddon">Nome</span>
                        <input type="text" class="form-control no-click" id="tbNome" name="tbNome"
                            aria-label="tbNome" aria-describedby="nomeAddon"
                            value="<%= colab ? colab.nome : '' %>"
                            required>
                    </div>
                </div>
            </div>

            <!-- Bloco 2: Contacto e Admissão -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="input-group">
                        <span class="input-group-text no-click" id="dataAdmissaoAddon">Data de Admissão</span>
                        <input type="date" class="form-control no-click" id="tbDataAdmissao" name="tbDataAdmissao"
                            aria-label="tbDataAdmissao" aria-describedby="dataAdmissaoAddon"
                            value="<%= colab ? formatDateInput(colab.dataAdmissao) : '' %>"
                            required>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="input-group">
                        <span class="input-group-text" id="emailAddon">Email institucional</span>
                        <input type="email" class="form-control no-click" id="tbEmail" name="tbEmail"
                            aria-label="tbEmail" aria-describedby="emailAddon"
                            value="<%= colab ? colab.email : '@uatlantica.pt' %>"
                            required>
                    </div>
                </div>
            </div>

            <!-- Bloco 3: Organização Interna -->
            <div class="row">

                <div class="col-md-12 mb-3">
                    <label for="cbDepartamento" class="form-label">Áreas Funcionais</label>
                    <!-- Select original: mantém-se para submissão do form, mas fica oculto visualmente -->
                    <select class="form-select no-click visually-hidden" id="cbDepartamento" name="cbDepartamento" multiple size="6" aria-label="Selecionar Área(s) Funcional(is)">
                        <% areasFunc.forEach(a => { 
                            const afeto = colab && colab.idsAreaFunc && colab.idsAreaFunc.some(id => id == a.idtbOpcaoAreasFunc);
                        %>
                            <option value="<%= a.idtbOpcaoAreasFunc %>" <%= afeto ? 'selected' : '' %>>
                                <%= a.sigla %> — <%= a.nome %>
                            </option>
                        <% }) %>
                    </select>

                    <!-- Representação visual legível, só para leitura -->
                    <div class="areas-funcionais-display">
                        <% areasFunc.forEach(a => {
                            const afeto = colab && colab.idsAreaFunc && colab.idsAreaFunc.some(id => id == a.idtbOpcaoAreasFunc);
                            const visivelPortal = colab && colab.idsAreaFuncVisiveis && colab.idsAreaFuncVisiveis.some(id => id == a.idtbOpcaoAreasFunc);
                            if (afeto) {
                        %>
                            <span class="area-badge <%= visivelPortal ? 'visivel' : 'nao-visivel' %>">
                                <%= a.sigla %> — <%= a.nome %>

                            </span>
                        <% } }) %>
                    </div>
                    
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="cbCatProfissional" class="form-label">Categoria Profissional</label>
                    <select class="form-select no-click" id="cbCatProfissional" name="cbCatProfissional" aria-label="Selecionar Categoria Profissional">
                        <option value="">-- Selecione --</option>
                        <% catColab.forEach(r => { %>
                            <option value="<%= r.idtrOpcaoCatColab %>"
                                <%= (colab && colab.idCatColab == r.idtrOpcaoCatColab) ? 'selected' : '' %>>
                                <%= r.nome %>
                            </option>
                        <% }) %>
                    </select>
                </div>

            

            <!-- Bloco 5: Contrato e Carga Horária -->
            
                <div class="col-md-6 mb-3">
                    <label for="cbCargo" class="form-label">Função</label>
                    <select class="form-select no-click" id="cbCargo" name="cbCargo" aria-label="Selecionar Tipo de Função">
                        <option value="">-- Selecione --</option>
                        <% funcoes.forEach(r => { %>
                            <option value="<%= r.idtbOpcaoFuncaoColab %>"
                                <%= (colab && colab.idFuncao == r.idtbOpcaoFuncaoColab) ? 'selected' : '' %>>
                                <%= r.nome %>
                            </option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="cbTipoContrato" class="form-label">Tipo de Contrato</label>
                    <select class="form-select no-click" id="cbTipoContrato" name="cbTipoContrato" aria-label="Selecionar Tipo de Contrato">
                        <option value="">-- Selecione --</option>
                        <% regimes.forEach(r => { %>
                            <option value="<%= r.idtbOpcaoRegimeColab %>"
                                <%= (colab && colab.idRegime == r.idtbOpcaoRegimeColab) ? 'selected' : '' %>>
                                <%= r.nome %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="tbCargaHoraria" class="form-label">Carga Horária Semanal</label>
                    <div class="input-group">
                        <input type="number" class="form-control no-click" id="tbCargaHoraria" name="tbCargaHoraria"
                            aria-label="tbCargaHoraria" aria-describedby="cargaHorariaAddon"
                            value="<%= colab ? colab.cargaHoraria : '' %>"
                            min="1" max="60">
                    </div>
                </div>
            </div>

            <!-- Bloco 6: Níveis QNQ -->
            <div class="row mb-4">
                <div class="col-12">
                    <label for="cbQNQ" class="form-label">Níveis de Qualificação (QNQ)</label>
                    <select class="form-select no-click" id="cbQNQ" name="cbQNQ" aria-label="Selecionar Nível QNQ">
                        <option value="">-- Selecione --</option>
                        <% niveisQNQ.forEach(n => { %>
                            <option value="<%= n.idtbOpcaoNiveisQNQ %>"
                                <%= (colab && colab.idNivelQNQ == n.idtbOpcaoNiveisQNQ) ? 'selected' : '' %>>
                                Nível <%= n.nivel %> — <%= n.nome %>
                            </option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <label for="tbAreaForma" class="form-label">Área de Formação</label>
                    <div class="input-group">
                        <select class="form-select " id="tbAreaForma" name="tbAreaForma" aria-label="Selecionar Area Formação">
                            <option value="">-- Selecione --</option>
                            <% cnaef.forEach(n => { %>
                                <option value="<%= n.idtbOpcaoAreaCient3Niv %>"
                                    <%= (colab && colab.areaFormacao == n.idtbOpcaoAreaCient3Niv) ? 'selected' : '' %>>
                                    <%= n.nomeAreaCient %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="tbOutForma" class="form-label">Outras Formações</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="tbOutForma" name="tbOutForma"
                            aria-label="tbOutForma" aria-describedby="outFormaAddon"
                            value="<%= colab ? colab.outrasFormacoes : '' %>">
                    </div>
                </div>
            </div>

            <!-- Botão de Submissão -->
            <div class="row">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary px-4">Submeter</button>
                </div>
            </div>
        </form>    

    </div>

  </div>
</div>

<%- include('partials/footer') %>
