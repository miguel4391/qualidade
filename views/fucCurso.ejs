<%- include('partials/header') %>

<div class="container mt-5">
	<div class="row">
		<div class="col-md-12">
			<p class="h2 text-red"><% if (fuc[0]) {%>  
										FUC - <%= fuc[0].nomeCE %>
									<% } %> </p>
		</div>
	</div>
    <div class="row">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Search" name="searchInput" id="searchInput">        
        </div>
    </div>
    <div class="row mt-3">
        <table class="table table-striped" name="fileTable" id="fileTable">
          <thead>
            <tr class="text-red">
              <th scope="col">Unidade Curricular</th>
            </tr>
          </thead>
          <tbody>
                <% fuc.forEach(function(file){ %>
                    <tr>
                        <td><a href="/fuc/<%= fuc[0].nomeCE %>/<%= file.nomeUCPt %>" target="_blank"><%= file.nomeUCPt %></a></td>
                    </tr>
                <% }) %> 
          </tbody>
        </table>
    </div>
    <div class="row my-3">
      <a href="/fuc" class="btn btn-outline-primary"><i class="fas fa-angle-double-left"></i></a>
    </div>
</div>

<script src="javascript/searchfilter.js" type="text/javascript"></script>

<%- include('partials/footer') %>
